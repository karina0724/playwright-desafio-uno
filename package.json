{
  "name": "demoqa-automation",
  "version": "1.0.0",
  "description": "Suite de automatización web E2E para https://demoqa.com/books aplicando Playwright + TypeScript, Page Object Model y BDD (Gherkin).",
  "author": "Karina Montero Leonardo",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:auth": "playwright test --project=auth",
    "test:books": "playwright test --project=books",
    "test:all": "playwright test --project=auth --project=books",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
