# ---------------------------------------------------------------------------
# Plantilla de variables de entorno
# Copia este archivo como `.env` y reemplaza los valores de ejemplo:
#   cp .env-template .env
#
# El archivo `.env` NO se versiona (ver .gitignore).
# ---------------------------------------------------------------------------

# Ambiente objetivo: debe coincidir con un archivo en config/environments/<name>.json
TEST_ENV=qa

# URL base (opcional — el valor efectivo se toma de config/environments/<env>.json)
BASE_URL=https://demoqa.com

# Credenciales del usuario válido previamente creado en demoqa.com
# Crear vía API:
#   curl -X POST https://demoqa.com/Account/v1/User \
#     -H "Content-Type: application/json" \
#     -d '{"userName":"automation_tester","password":"Test@1234!"}'
USER_NAME=automation_tester
USER_PASSWORD=Test@1234!

# Credenciales inválidas usadas para pruebas negativas
INVALID_USER_NAME=invalid_user_xyz
INVALID_PASSWORD=WrongPass123!

# Flags de ejecución
HEADLESS=true
WORKERS=2
RETRIES=1
